# Local development values. Copy to .env.local and fill in.
# Public values: safe to expose to the browser, read-only through RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: used by seed/export scripts and admin operations.
# Never commit this value and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects POST /api/revalidate. Generate with: openssl rand -hex 32
REVALIDATE_SECRET=your-revalidate-secret

# Canonical site URL used for metadata, sitemap, and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
